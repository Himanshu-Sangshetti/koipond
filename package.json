{
  "name": "koipond",
  "version": "0.1.0",
  "description": "A living koi pond for the web: procedural koi with real water (refraction, caustics, ripples) in WebGL2. React component + framework-free core.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external react --external three",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "three": ">=0.160"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "three": "^0.170.0",
    "@types/three": "^0.170.0"
  },
  "keywords": [
    "koi",
    "pond",
    "webgl",
    "webgl2",
    "water",
    "caustics",
    "procedural-animation",
    "react",
    "canvas",
    "generative"
  ],
  "license": "MIT"
}
{
  "name": "koipond",
  "version": "0.1.0",
  "description": "A living koi pond for the web: procedural koi with real water (ripples, refraction, light) in WebGL2 via three.js. A drop-in React component.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "three": ">=0.160"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/three": "^0.170.0",
    "react": "^19.0.0",
    "three": "^0.170.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "koi",
    "koi-pond",
    "pond",
    "water",
    "ripples",
    "caustics",
    "webgl",
    "webgl2",
    "three",
    "threejs",
    "react",
    "procedural-animation",
    "generative",
    "background",
    "hero"
  ],
  "license": "MIT",
  "author": "koipond contributors",
  "engines": {
    "node": ">=18"
  }
}
